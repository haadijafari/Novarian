# ==================================
# General & Global Ignores
# ==================================

# Environment variables
.env*
!.env.example

# Log files
*.log
bun-debug.log*

# ==================================
# Frontend (Next.js / Bun)
# ==================================

# Dependencies
**/node_modules

# Next.js build artifacts
frontend/.next/
frontend/out/

# TypeScript specific
# Auto-generated type definitions and build cache.
frontend/next-env.d.ts
frontend/*.tsbuildinfo

# Production build directory
frontend/build/
